+/* A one-shot device timeout is rescheduled while establishment is pending.
+ * This reports worker failures during asynchronous USB waits. Blocking socket
+ * calls can still delay the main loop: their deadlines are a separate finding. */
+static void
+goodix_tls_poll (FpDevice *dev, gpointer user_data)
+{
+  FpiDeviceGoodixTlsPrivate *priv = fpi_device_goodixtls_get_instance_private (
+    FPI_DEVICE_GOODIXTLS (dev));
+  priv->tls_poll = NULL;
+  if (!priv->tls_ready_callback || !priv->tls_hop)
+    return;
+  int result = g_atomic_int_get (&priv->tls_hop->accept_result);
+  if (result < 0)
+    {
+      GError *error = goodix_tls_accept_error (priv->tls_hop);
+      /* Reset a registered command callback before its SSM can be freed. */
+      if (priv->ack || priv->reply)
+        goodix_receive_done (dev, NULL, 0, error);
+      else if (priv->tls_ssm)
+        fpi_ssm_mark_failed (priv->tls_ssm, error);
+      else
+        goodix_tls_finish (dev, error);
+      return;
+    }
+  if (result > 0 && priv->tls_ssm &&
+      fpi_ssm_get_cur_state (priv->tls_ssm) == TLS_HANDSHAKE_STAGE_WAIT_ACCEPT)
+    {
+      fpi_ssm_next_state (priv->tls_ssm);
+      return;
+    }
+  priv->tls_poll = fpi_device_add_timeout (dev, 10, goodix_tls_poll, NULL, NULL);
+}
